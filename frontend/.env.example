# ---------------------------------------------------------------------------
# Data source
#   mock -> in-memory fixtures, no backend needed (default, good for UI review)
#   live -> real HTTP calls against the Express API
# ---------------------------------------------------------------------------
VITE_API_MODE=mock

# Prefix the API is mounted under. Requests go through the Vite dev proxy,
# so a relative value keeps the browser on a single origin.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api and /files.
VITE_BACKEND_URL=http://localhost:4000
