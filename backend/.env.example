# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Comma separated list of allowed origins for CORS ("*" allows everything)
CORS_ORIGIN=*

# Calendar the shop lives in. Reports derive "today" from this zone, not from
# the server's UTC date.
APP_TIMEZONE=Asia/Kathmandu

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Special characters in the password must be percent-encoded: @ is %40, # is %23.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/retails_records?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Treat a request with no bearer token as the first active admin. This was a
# stand-in for the login screen; now that one exists it stays off, so the app
# and plain curl are held to the same rule. Ignored entirely when
# NODE_ENV=production.
AUTH_DEV_FALLBACK=false

# ---------------------------------------------------------------------------
# File storage (physical bills / vouchers)
# STORAGE_DRIVER: local | cloudinary   (s3 is reserved, not implemented yet)
# It only picks where NEW uploads go. Existing files stay with the driver that
# wrote them, so keep these settings for as long as any file lives there.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_BASE_URL=http://localhost:4000/files
MAX_UPLOAD_SIZE_MB=10

# Required when STORAGE_DRIVER=cloudinary. From the Cloudinary console, under
# Settings > API Keys. Use a different folder per environment so development
# uploads never mix with the shop's real bills.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=retails_records

# ---------------------------------------------------------------------------
# Logging: fatal | error | warn | info | debug | trace
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
